PORT=3000
GOOGLE_DRIVE_FOLDER_ID=請填你的資料夾ID
GITHUB_PAGES_ORIGIN=
DRIVE_ENABLED=true
FACE_SERVICE_URL=http://127.0.0.1:5001
MAX_ACTIVE_UPLOADS=8
DRIVE_WORKERS=2
# DATA_DIR 預設為此專案的 data；自訂時 Node 與 Python 必須使用同一絕對路徑。
# DATA_DIR=/absolute/path/to/wedding-data

# 人物分組比自拍搜尋嚴格，降低不同人被併在一起的機會。
GROUP_THRESHOLD=0.50
GROUP_MARGIN=0.06
SEARCH_THRESHOLD=0.30
# 精確向量化搜尋，維持門檻與結果格式；需要比對原逐臉版本時改 scalar。
FACE_SEARCH_MODE=vectorized
# P5 回填由 Python 向本機 Node 取得原圖；自訂 Node PORT 時可明確指定。
# FACE_BACKFILL_SOURCE_URL=http://127.0.0.1:3000
FACE_BACKFILL_MAX_BYTES=104857600

# 本機人臉改善：legacy 沿用既有行為；shadow 記錄比較但仍使用舊結果；enhanced 為待校準的新策略。
# 先用離線 evaluate_faces.py 驗收；只影響新分析照片，不重建既有人物或合併紀錄。
FACE_PIPELINE=legacy
GROUP_MODE=legacy
FACE_MAX_PIXELS=60000000
FACE_TILE_SIZE=1024
FACE_TILE_OVERLAP=0.25
FACE_MAX_TILES=32
# 分區偵測時間預算；單次 OpenCV 呼叫不可中斷，超出會標記 partial。
FACE_TILE_SECONDS=10
FACE_MIN_PIXELS=32
FACE_MIN_SHARPNESS=20
# 與舊 GROUP_THRESHOLD/GROUP_MARGIN 獨立；以下是保守實驗初值，未經婚禮標註資料校準。
GROUP_V2_THRESHOLD=0.60
GROUP_V2_MARGIN=0.08
GROUP_V2_SINGLE_THRESHOLD=0.65
GROUP_V2_SAMPLE_THRESHOLD=0.70
GROUP_V2_SAMPLE_MARGIN=0.10

# 管理功能：自行設定至少 12 字元的密碼；空白時關閉管理功能。
ADMIN_PASSWORD=
# 本機 HTTP 測試留 false；部署到 HTTPS 後設 true。
ADMIN_COOKIE_SECURE=false

# 讀取 Drive 既有照片並持續同步；包含子資料夾。
DRIVE_SYNC_ENABLED=true
DRIVE_SYNC_SUBFOLDERS=true
DRIVE_SYNC_INTERVAL_SECONDS=300
DRIVE_SYNC_MAX_FILE_MB=100

# 前後端分離：多個前端完整來源以逗號分隔。
FRONTEND_ORIGINS=http://localhost:5173
# true 時 Node 也提供 ../frontend 畫面，方便同源測試；false 時只有 API。
SERVE_FRONTEND=true

# 選填：新上傳照片要備份到另一個資料夾（例如 Guests_upload/Original），填該子資料夾 ID。
# 空白沿用 GOOGLE_DRIVE_FOLDER_ID；雲端舊照片仍由 GOOGLE_DRIVE_FOLDER_ID 開始同步。
GOOGLE_DRIVE_UPLOAD_FOLDER_ID=

# 預設分析完成、確認雲端原圖仍存在後，自動清除本機暫存原圖。
KEEP_LOCAL_ORIGINALS=false
# 選填：給賓客「看全部照片」的 Drive 資料夾網址；空白沿用掃描資料夾。
GOOGLE_DRIVE_ALL_PHOTOS_URL=

# 喜帖預設由瀏覽器原生提交，不需要此後端設定。
# 選用 submissionMode:backend 時，此開關控制後端是否提交 Google 表單。
WEDDING_GOOGLE_FORMS_ENABLED=true
